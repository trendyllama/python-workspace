{
  "name": "python-workspace",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "postCreateCommand": "uv sync --locked && npm ci --prefix src/tutorial_app/client",
  "forwardPorts": [8000, 5173],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "astral-sh.ty",
        "ms-python.debugpy"
      ]
    }
  }
}